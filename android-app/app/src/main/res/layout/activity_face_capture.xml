<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FDF8FF">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Face Registration"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#292333" />

    <!-- Status / info -->
    <TextView
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap Open Camera to begin."
        android:textSize="13sp"
        android:textColor="#49454F"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <!-- Camera preview with oval guide + live feedback overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#202020"
            app:scaleType="fillCenter"
            app:implementationMode="compatible" />

        <!-- Oval guide overlay, same drawable as the liveness screen -->
        <View
            android:id="@+id/fcFaceOval"
            android:layout_width="200dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:background="@drawable/oval_face_guide"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- Live positioning feedback, overlaid at bottom of preview -->
        <TextView
            android:id="@+id/fcPositionHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="#B3000000"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text=""
            android:visibility="gone" />

    </FrameLayout>

    <!-- Guidelines card, shown before the camera opens -->
    <LinearLayout
        android:id="@+id/fcGuidelinesCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:layout_marginTop="10dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Photo Guidelines"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#292333"
            android:paddingBottom="8dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingBottom="4dp">
            <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                android:text="&#8226;" android:textSize="13sp" android:textColor="#6650A4" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="13sp" android:textColor="#49454F"
                android:text="Keep your face centred inside the oval." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingBottom="4dp">
            <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                android:text="&#8226;" android:textSize="13sp" android:textColor="#6650A4" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="13sp" android:textColor="#49454F"
                android:text="Move closer until your face fills the oval." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingBottom="4dp">
            <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                android:text="&#8226;" android:textSize="13sp" android:textColor="#6650A4" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="13sp" android:textColor="#49454F"
                android:text="Look directly at the camera." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingBottom="4dp">
            <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                android:text="&#8226;" android:textSize="13sp" android:textColor="#6650A4" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="13sp" android:textColor="#49454F"
                android:text="Good lighting - avoid strong backlighting." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingBottom="4dp">
            <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                android:text="&#8226;" android:textSize="13sp" android:textColor="#6650A4" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="13sp" android:textColor="#49454F"
                android:text="Hold still while capturing." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                android:text="&#8226;" android:textSize="13sp" android:textColor="#6650A4" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="13sp" android:textColor="#49454F"
                android:text="Your full face must be clearly visible." />
        </LinearLayout>

    </LinearLayout>

    <!-- Capture button -->
    <Button
        android:id="@+id/capture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="OPEN CAMERA" />

    <!-- Upload / verify button -->
    <Button
        android:id="@+id/upload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="VERIFY / REGISTER PHOTO"
        android:enabled="false" />

</LinearLayout>
