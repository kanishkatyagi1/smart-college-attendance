<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMART CAMPUS"
            android:textColor="#1769AA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Student Account"
            android:textColor="#102B50"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="22dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF">

            <EditText
                android:id="@+id/regName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Full Name"
                android:inputType="textPersonName"
                android:padding="14dp"
                android:background="#F1F5FA"/>

            <EditText
                android:id="@+id/regEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:background="#F1F5FA"/>

            <EditText
                android:id="@+id/regPhone"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Phone Number"
                android:inputType="phone"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:background="#F1F5FA"/>

            <EditText
                android:id="@+id/regRollNumber"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Roll Number"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:background="#F1F5FA"/>

            <EditText
                android:id="@+id/regCourse"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Course (e.g. B.Tech CSE)"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:background="#F1F5FA"/>

            <EditText
                android:id="@+id/regSemester"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Semester (1-12)"
                android:inputType="number"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:background="#F1F5FA"/>

            <EditText
                android:id="@+id/regSection"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Section (e.g. CSE-A)"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:background="#F1F5FA"/>

            <EditText
                android:id="@+id/regPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Password (minimum 8 characters)"
                android:inputType="textPassword"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:background="#F1F5FA"/>

            <EditText
                android:id="@+id/regConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Confirm Password"
                android:inputType="textPassword"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:background="#F1F5FA"/>

            <Button
                android:id="@+id/registerStudent"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CREATE ACCOUNT"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#1769AA"
                android:layout_marginTop="22dp"/>

            <TextView
                android:id="@+id/registerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#D32F2F"
                android:padding="12dp"/>

            <TextView
                android:id="@+id/backToLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Already registered? Sign In"
                android:textColor="#1769AA"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
