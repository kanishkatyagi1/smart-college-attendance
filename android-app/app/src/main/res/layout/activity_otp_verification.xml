<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMART CAMPUS"
            android:textColor="#1769AA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verify Your Email"
            android:textColor="#102B50"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/otpEmailInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter the 6-digit OTP sent to your email."
            android:textColor="#52657D"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/otpInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="6-digit OTP"
            android:inputType="number"
            android:maxLength="6"
            android:gravity="center"
            android:textSize="24sp"
            android:letterSpacing="0.3"
            android:layout_marginTop="28dp"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <Button
            android:id="@+id/verifyOtpButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="VERIFY EMAIL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#1769AA"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/resendOtpButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="RESEND OTP"
            android:textColor="#1769AA"
            android:backgroundTint="#E3EDF8"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/otpStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#D32F2F"
            android:padding="14dp" />

    </LinearLayout>
</ScrollView>
